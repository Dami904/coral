# Which deployment this process talks to. Defaults to sepolia (free,
# testnet) if unset — every var below the mainnet section is only ever
# required when this is explicitly set to "mainnet".
NETWORK=sepolia

DEPLOYER_PRIVATE_KEY=0x_owner_testnet_key_never_a_real_key
AGENT_ADDRESS=0x_the_agent_processes_wallet_address
AGENT_PRIVATE_KEY=0x_the_agent_processes_signing_key_needs_its_own_gas_eth
VENDOR_PAYTO_ADDRESS=0x_test_paytO_address_you_control
VENDOR_PRIVATE_KEY=0x_only_needed_if_you_want_to_move_funds_out_of_the_test_vendor_wallet
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# Filled in after `pnpm deploy:testnet` — see PLAN.md's Day 2 entry.
SPEND_GUARD_ADDRESS=0x_deployed_SpendGuard_address
MOCK_USDC_ADDRESS=0x_deployed_MockUSDC_address

# Direction B (gateway): USDC (6dp) another agent must pay the deployed
# SpendGuard contract itself to redeem one check over Ping. Optional —
# defaults to 500000 ($0.50), above Sibyl's real $0.25 price. See PLAN.md's
# "Gateway direction" entry.
GATEWAY_FEE_USDC_6DP=500000

# ── Mainnet (NETWORK=mainnet only) ──────────────────────────────────────
# Real funds, real gas, real irreversible transactions. Do not fill these
# in or set NETWORK=mainnet until you've deliberately decided to fund and
# broadcast — see docs/LIMITATIONS.md and PLAN.md's "Still open" section.
BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Filled in after `pnpm deploy:mainnet`.
MAINNET_SPEND_GUARD_ADDRESS=0x_deployed_mainnet_SpendGuard_address
# Must be the REAL payTo from a live /api/evaluate 402 response
# (docs/API_NOTES.md) — never a placeholder, this is where real funds go.
MAINNET_VENDOR_PAYTO_ADDRESS=0x_sibyl_real_payTo_address
# Real Base USDC — has a sane default, override only if it ever changes.
MAINNET_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Required by scripts/live-ping-register.ts — the username to register
# the agent wallet under on Ping (real, one-time, mainnet-only gas spend).
PING_USERNAME=

# sibyl-memory-mcp must be on PATH or pointed at directly (pip install
# sibyl-memory-mcp, or a local venv — see docs/API_NOTES.md).
SIBYL_MEMORY_MCP_COMMAND=sibyl-memory-mcp
# Pin to a project-local path so "delete the DB" in a demo/test never
# touches your real ~/.sibyl-memory.
SIBYL_MEMORY_DB=.sibyl-memory-demo/memory.db
